### Development authentication
POST http://localhost:3000/auth/test-login

> {%
  client.global.set("accessToken", response.body.accessToken);
%}

### Start a new conversation
POST http://localhost:3000/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "prompt": "Bolí ma hlava už tri dni. Najdi mi lekára. Nepýtaj ďalšie otázky."
}

> {%
  client.global.set("streamId", response.body.streamId);
  client.global.set("sessionId", response.body.sessionId);
%}

### Stream the first response
GET http://localhost:3000/chat/stream/{{streamId}}
Authorization: Bearer {{accessToken}}
Accept: text/event-stream

### Answer a location_request while the stream above waits
# Paste the requestId from the "location_request" event; "source": "declined" skips it.
POST http://localhost:3000/chat/location
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "requestId": "paste-from-the-stream",
  "source": "current",
  "location": { "lat": 48.7164, "lon": 21.2611, "label": "Košice - Staré Mesto" }
}

### Continue the conversation
POST http://localhost:3000/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "prompt": "A mám aj teplotu.",
  "sessionId": "{{sessionId}}"
}

> {%
  client.global.set("streamId", response.body.streamId);
%}

### Stream the follow-up response
GET http://localhost:3000/chat/stream/{{streamId}}
Authorization: Bearer {{accessToken}}
Accept: text/event-stream

### Get chat history
GET http://localhost:3000/chat/history/{{sessionId}}
Authorization: Bearer {{accessToken}}

### Get all sessions
GET http://localhost:3000/chat/sessions
Authorization: Bearer {{accessToken}}

### Rename the session
PATCH http://localhost:3000/chat/sessions/{{sessionId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Headache consultation"
}

### Test the emergency checker
POST http://localhost:3000/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "prompt": "Silno krvácam."
}

> {%
  client.global.set("emergencyStreamId", response.body.streamId);
%}

### Stream the emergency response
GET http://localhost:3000/chat/stream/{{emergencyStreamId}}
Authorization: Bearer {{accessToken}}
Accept: text/event-stream
