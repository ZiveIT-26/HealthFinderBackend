# NO REAL KEY HERE
# MAKE YOURSELF YOUR OWN .env FILE WITH YOUR OWN KEYS AND PASSWORDS
# USE THIS AS A TEMPLATE
DB_CONNECTION_STRING=postgres://user:password@localhost:65432/healthfinder

# --- Model ---
# openai.com API key
OPENAI_API_KEY=

# Ollama's OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=bonsai-2-9b-16k
# AVAILABLE MODELS: qwen3:4b, qwen3-4b-16k, qwen3-4b-instruct-8k, qwen3:4b-instruct, bonsai-2-9b-8k, bonsai-2-9b-16k, medgemma:4b
# thinking effort: none, low, medium, high. Default: none.
LLM_REASONING_EFFORT=none

# Optional: another model only for the triage step
LLM_TRIAGE_MODEL=

# --- Other ---
TAVILY_API_KEY=

# HTTP port of the backend (default 3000).
# PORT=3000
